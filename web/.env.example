# Copy to .env.local to override web/.env on your machine (e.g. to test sign-in locally).
# Supabase → Project Settings → API. The publishable (anon) key is public by design; Row Level Security protects each user's data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key
# Sign-in methods to show: email, google (comma separated). Empty = sign-in hidden.
VITE_AUTH_PROVIDERS=email,google
